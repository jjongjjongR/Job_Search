# No-cost local backend settings

PORT=3001
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=world_job_search
DB_SYNCHRONIZE=false

JWT_SECRET=local-dev-secret-change-before-prod
JWT_EXPIRES_IN=1h

AI_INTERNAL_BASE_URL=http://localhost:8000
AI_INTERNAL_SHARED_SECRET=local-internal-secret
AI_INTERNAL_REQUEST_TIMEOUT_MS=30000
AI_COVER_LETTER_FEEDBACK_TIMEOUT_MS=180000

# Leave paid provider keys empty.
OPENAI_API_KEY=
STORAGE_PROVIDER=local
BACKEND_STORAGE_ROOT=storage
TEMP_FILE_RETENTION_SECONDS=600

# Optional for email verification tests.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=World Job Search <your-gmail@example.com>
