PORT=3001
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=world_job_search
DB_SYNCHRONIZE=false

JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=1h

# Future internal AI server connection
AI_INTERNAL_BASE_URL=http://localhost:8000
AI_INTERNAL_SHARED_SECRET=replace-with-internal-secret
AI_INTERNAL_REQUEST_TIMEOUT_MS=30000
AI_COVER_LETTER_FEEDBACK_TIMEOUT_MS=180000

# Storage
STORAGE_PROVIDER=local
BACKEND_STORAGE_ROOT=storage
TEMP_FILE_RETENTION_SECONDS=600

# Email verification SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=World Job Search <your-gmail@example.com>

# Paid provider key. Leave empty for no-cost local fallback.
OPENAI_API_KEY=

# AWS production checklist:
# NODE_ENV=production
# FRONTEND_URL=https://your-frontend-domain.example
# DB_SYNCHRONIZE=false
# JWT_SECRET must be 32+ chars and stored in Secrets Manager.
# AI_INTERNAL_SHARED_SECRET must match ai INTERNAL_SHARED_SECRET and be 32+ chars.
# AI_INTERNAL_BASE_URL must point to the private AI service URL, not localhost.
