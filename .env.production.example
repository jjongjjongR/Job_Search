# 2026-05-22 신규: EC2 단일 서버 최소비용 배포용 환경변수 예시
# 실제 비밀값은 이 파일에 넣지 말고 EC2 서버의 .env.production에서만 수정하세요.

# Public URLs
FRONTEND_URL=http://CHANGE_ME_EC2_PUBLIC_IP_OR_DOMAIN
NEXTAUTH_URL=http://CHANGE_ME_EC2_PUBLIC_IP_OR_DOMAIN
# EC2 배포 compose에서는 /backend로 고정합니다. 특별한 이유가 없으면 바꾸지 마세요.
NEXT_PUBLIC_API_BASE_URL=/backend

# Backend
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h

# Database inside Docker network
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=world_job_search
# 발표용 최초 DB 생성이 필요하면 true로 바꿔 1회 기동 후 false로 되돌리세요.
DB_SYNCHRONIZE=false

# Backend <-> FastAPI internal auth
AI_INTERNAL_SHARED_SECRET=CHANGE_ME
# 공고 분석 등 일반 AI 내부 호출 timeout은 30초, 자소서 피드백은 RAG/LLM workflow라 더 길게 둡니다.
AI_INTERNAL_REQUEST_TIMEOUT_MS=30000
AI_COVER_LETTER_FEEDBACK_TIMEOUT_MS=180000
AI_INTERVIEW_ANSWER_TIMEOUT_MS=180000

# Email verification SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=World Job Search <your-gmail@example.com>

# AI/OpenAI
OPENAI_API_KEY=
OPENAI_JOB_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Redis temp state
REDIS_DEFAULT_TTL_SECONDS=600
REDIS_CLEANUP_WORKER_ENABLED=true
REDIS_CLEANUP_INTERVAL_SECONDS=30

# NextAuth/social login
NEXTAUTH_SECRET=CHANGE_ME
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
