# No-cost local AI settings
# Copy to ai/.env only when you want a strictly local fallback run.

INTERNAL_SHARED_SECRET=local-internal-secret

# Leave all paid provider keys empty. The code falls back to local heuristic/RAG rules.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL_SECONDS=600
REDIS_CLEANUP_WORKER_ENABLED=true
REDIS_CLEANUP_INTERVAL_SECONDS=30

COVER_LETTER_RAG_DB_PATH=data/chroma_rag
BACKEND_STORAGE_ROOT=../backend/storage
